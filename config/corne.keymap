// Corne Keyboard Configuration - Swedish Layout
// Layer 4 Gaming: Press RSE + RALT together to toggle

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        combos {
                compatible = "zmk,combos";
                combo_layer4 {
                        timeout-ms = <50>;
                        key-positions = <40 41>;
                        bindings = <&tog 3>;
                };
        };

        // Dead-key symbols under a Swedish (sv-SE) OS layout: press the dead key
        // then space so the standalone diacritic character is produced.
        macros {
                sw_caret: sw_caret {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp LS(RBKT) &kp SPACE>;
                };
                sw_tilde: sw_tilde {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp RA(RBKT) &kp SPACE>;
                };
                sw_grave: sw_grave {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp LS(EQUAL) &kp SPACE>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |             |  Y  |  U   |  I  |  O  |  P  |  Å  |
// | SHFT |  A  |  S  |  D  |  F  |  G  |             |  H  |  J   |  K  |  L  |  ;  |  '  |
// | LCTRL|  Z  |  X  |  C  |  V  |  B  |             |  N  |  M   |  ,  |  .  |  /  | ESC |
//                    | GUI | LWR | SPC |             | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp LBKT
   &kp LSHFT &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
                        display-name = "Lower Layer";
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |             |  6  |  7  |  8  |  9  |  0  | BSPC |
// | SHFT | BT1 | BT2 | BT3 | BT4 | BT5 |             |BTCLR| F11 | F12 |     |QMARK|      |
// | LCTRL| F1  |  F2 |  F3 |  F4 |  F5 |             |  F6 |  F7 |  F8 |  F9 | F10 | ESC  |
//                    | GUI |     | SPC |             | ENT |     | ALT |
                        bindings = <
   &kp ESC    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6     &kp N7   &kp N8  &kp N9    &kp N0     &kp BSPC
        &kp LSHFT  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &bt BT_CLR &kp F11  &kp F12 &trans     &kp LS(MINUS)  &trans
   &kp LCTRL  &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &kp F6     &kp F7   &kp F8  &kp F9    &kp F10    &kp ESC
                                        &kp LGUI     &trans       &kp SPACE      &kp RET    &trans   &kp RALT
                        >;
                };
                raise_layer {
                        display-name = "Raise Layer";
// Bindings below send the US HID keycode/modifier combo that a Swedish (sv-SE)
// OS keyboard layout maps to the symbol shown in the comment (plain &kp with
// US-named keycodes like AMPS/ASTRK/PIPE/TILDE produce the wrong character on
// sv-SE, since the OS remaps shift/AltGr differently than on a US layout).
// -----------------------------------------------------------------------------------------
// |  ESC |  !  |  @  |  #  |  $  |  %  |             |  ^  |  &  |  *  |  (  |  )  | DEL  |
// | SHFT |  LT |  UP |  GT |     |     |             |  -  |  =  |  [  |  ]  |  \  |  `   |
// | LCTRL| LFT | DWN | RGT |     |     |             |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |             | ENT |     | ALT |
                        bindings = <
   &kp  ESC  &kp EXCL &kp RA(N2) &kp HASH  &kp RA(N4) &kp PRCNT   &sw_caret     &kp LS(N6)   &kp LS(NUHS) &kp LS(N8) &kp LS(N9) &kp DEL
   &kp LSHFT &kp NUBS &kp UP     &kp LS(NUBS) &trans  &trans      &kp FSLH      &kp LS(N0)   &kp RA(N8)   &kp RA(N9) &kp RA(MINUS) &sw_grave
   &kp LCTRL &kp LEFT &kp DOWN   &kp RIGHT &trans     &trans      &kp LS(FSLH)  &kp MINUS    &kp RA(N7)   &kp RA(N0) &kp RA(NUBS)  &sw_tilde
                                &kp LGUI  &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                layer4 {
                        display-name = "Gaming";
// -----------------------------------------------------------------------------------------
// | TAB  |  1  |  W  |  2  |  3  |  4  |             | NP7 | NP8 | NP9 |  J  |  G  |     |
// | CTRL |  A  |  S  |  D  |  5  |  F  |             | NP4 | NP5 | NP6 |  M  |     |     |
// | SHFT |  I  |  H  |  X  |  C  |  J  |             | NP1 | NP2 | NP3 |  N  |     |     |
//                    |  Z  |  V  | SPC |             | ENT | RSE | ALT |
                        bindings = <
   &kp TAB   &kp N1 &kp W  &kp N2 &kp N3 &kp N4     &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp J     &kp G  &trans
   &kp LCTRL &kp A  &kp S  &kp D  &kp N5 &kp F      &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp M     &trans &trans
   &kp LSHFT &kp I  &kp H  &kp X  &kp C  &kp J      &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp N     &trans &trans
                           &kp Z  &kp V  &kp SPACE  &kp RET   &mo 2     &kp RALT
                        >;
                };
        };
};
